#!/bin/bash

set -eux

my_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# This script expects that it lives one directory below the base directory.
base_dir="$( cd "${my_dir}/.." && pwd )"

pushd "${base_dir}" > /dev/null
  go run github.com/onsi/ginkgo/v2/ginkgo run \
    -p \
    -r \
    -race \
    --randomize-all \
    --randomize-suites \
    --fail-on-pending \
    "$@"
popd > /dev/null
